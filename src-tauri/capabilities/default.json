{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/TimeTravelCoder/LedgerProMax"
        },
        {
          "url": "https://github.com/TimeTravelCoder/LedgerProMax/releases"
        }
      ]
    }
  ]
}
