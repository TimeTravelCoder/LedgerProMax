{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ledger Pro Max",
  "version": "1.2.0",
  "identifier": "com.timetravelcoder.ledgerpromax",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ledger Pro Max",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowPosition": { "x": 400, "y": 200 },
        "windowSize": { "width": 600, "height": 400 },
        "applicationFolderPosition": { "x": 150, "y": 200 },
        "appPosition": { "x": 450, "y": 200 }
      },
      "signingIdentity": null
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
